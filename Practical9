%{
#include <stdio.h>
#include <math.h>
#define YYSTYPE double
int yylex(void);
void yyerror(const char *s);
%}
%token NUMBER
%token INC DEC
%token INVALID
%left '+' '-'
%left '*' '/' '%'
%right '^'
%%
input:
        | input line
        ;
line:
        expr '\n'
        {
            printf("Result = %g\n", $1);
        }
        | '\n'
        {
        }
        | error '\n'
        {
            printf("Error: Invalid expression. Please try again.\n");
            yyerrok;
        }
        ;
expr:
        NUMBER
        {
            $$ = $1;
        }
        | expr '+' expr
        {
            $$ = $1 + $3;
        }
        | expr '-' expr
        {
            $$ = $1 - $3;
        }
        | expr '*' expr
        {
            $$ = $1 * $3;
        }
        | expr '/' expr
        {
            if ($3 == 0)
            {
                yyerror("Division by zero");
                $$ = 0;
            }
            else
            {
                $$ = $1 / $3;
            }
        }
        | expr '%' expr
        {
            if ($3 == 0)
            {
                yyerror("Modulus by zero");
                $$ = 0;
            }
            else
            {
                $$ = fmod($1, $3);
            }
        }
        | expr '^' expr
        {
            $$ = pow($1, $3);
        }
        | INC NUMBER
        {
            $$ = $2 + 1;
        }
        | DEC NUMBER
        {
            $$ = $2 - 1;
        }
        | '(' expr ')'
        {
            $$ = $2;
        }
        ;
%%

void yyerror(const char *s)
{
    printf("Error: %s\n", s);
}

int main()
{
    printf(" SDT DESK CALCULATOR \n");
    printf("Operators: + - * / %% ^ ++ --\n");
    printf("Press Ctrl+D to exit.\n\n");

    yyparse();

    return 0;
}
